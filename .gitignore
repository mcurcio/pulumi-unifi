# --- Go ---
# Compiled binaries / plugin output (binaries build into /bin/). Anchored with a
# leading slash so they don't match the source dirs provider/cmd/pulumi-*-unifi/.
/bin/
/pulumi-resource-unifi
/pulumi-gen-unifi
*.exe
*.test
*.out
vendor/

# --- Generated / fetched build artifacts (regenerated by `make generate`) ---
# Nothing here is committed. The pinned spec is fetched at build (openapi/fetch.sh);
# the schema, CRUD metadata, fixed OpenAPI doc, and Python SDK are build outputs.
/openapi/unifi-network-*.json
# schema.json and metadata.json are the FROZEN contract goldens (owned by `make
# schema`), committed on purpose and gated byte-for-byte by the `contract` CI job
# — NOT gitignored. openapi_generated.yml stays a purely-internal build artifact.
/provider/cmd/pulumi-resource-unifi/openapi_generated.yml
# The entire sdk/ tree is generated by `pulumi package gen-sdk` (sdk/python today,
# other languages later) — nothing in it is committed.
/sdk/

# --- Docs (MkDocs Material + mike) ---
# The rendered site and the docs tooling venv are build outputs. The API
# reference page is auto-generated from schema.json by docs/gen_reference.py and
# regenerated by `make docs` and CI, so it is NOT committed either — it is a
# disposable stopgap with zero coupling into the provider/SDK build.
/site/
/.docsvenv/
/docs/site/reference.md

# --- Pulumi ---
Pulumi.*.yaml
.pulumi/

# --- Python (generated SDK + local envs) ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.sdkvenv/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# --- Secrets / local config ---
# Never commit a real UniFi API key.
*.env
.env.*
!.env.example
# openapi/pin.env is the committed pin manifest (spec version/SHA/checksum — the
# single source of truth), NOT a secret. Force-track it past the *.env rule.
!openapi/pin.env
# test/e2e/seed.env is the THROWAWAY e2e controller's baked key + bundled Network
# version — committed on purpose (disposable test controller), so force-track it
# past the *.env rule too. The seed snapshot itself (test/e2e/unifi-seed.tgz) is
# committed via git-lfs (see .gitattributes); neither is gitignored.
!test/e2e/seed.env

# --- Test harness (generated TLS material + e2e scratch) ---
test/mock/certs/
test/e2e/certs/
# Throwaway restore/extract dirs the e2e scripts may stage locally (the real
# restore goes into a Docker volume, but guard against any local scratch).
test/e2e/restore/
test/e2e/.scratch/
test/e2e/*.tmp

# --- Editor / OS ---
.DS_Store
.idea/
.vscode/

# --- Local agent / tooling state (swarm session id, etc.) ---
# Machine-local Claude tooling state — never committed.
/.claude/
