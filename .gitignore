# --- Go ---
# Compiled binaries / plugin output (binaries build into /bin/). Anchored with a
# leading slash so they don't match the source dirs provider/cmd/pulumi-*-unifi/.
/bin/
/pulumi-resource-unifi
/pulumi-gen-unifi
*.exe
*.test
*.out
vendor/

# --- Generated / fetched build artifacts (regenerated by `make generate`) ---
# Nothing here is committed. The pinned spec is fetched at build (openapi/fetch.sh);
# the schema, CRUD metadata, fixed OpenAPI doc, and Python SDK are build outputs.
/openapi/unifi-network-*.json
/provider/cmd/pulumi-resource-unifi/schema.json
/provider/cmd/pulumi-resource-unifi/metadata.json
/provider/cmd/pulumi-resource-unifi/openapi_generated.yml
# The entire sdk/ tree is generated by `pulumi package gen-sdk` (sdk/python today,
# other languages later) — nothing in it is committed.
/sdk/

# --- Pulumi ---
Pulumi.*.yaml
.pulumi/

# --- Python (generated SDK + local envs) ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.sdkvenv/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# --- Secrets / local config ---
# Never commit a real UniFi API key.
*.env
.env.*
!.env.example
# openapi/pin.env is the committed pin manifest (spec version/SHA/checksum — the
# single source of truth), NOT a secret. Force-track it past the *.env rule.
!openapi/pin.env

# --- Test harness (generated TLS material) ---
test/mock/certs/
test/e2e/certs/

# --- Editor / OS ---
.DS_Store
.idea/
.vscode/

# --- Local agent / tooling state (swarm session id, etc.) ---
# Machine-local Claude tooling state — never committed.
/.claude/
