# Single source of truth for the pinned UniFi Network Integration API spec.
#
# Shell-sourceable (read by openapi/fetch.sh and the Makefile via `include`) AND
# parsed by the Go side (provider/pkg/gen reads SPEC_VERSION; a test asserts the
# Go pinnedSpecVersion constant agrees, so a half-finished version bump fails CI
# rather than silently generating from the wrong spec). To bump: change the four
# values here (+ re-verify the checksum), nothing else.
SPEC_REPO=beezly/unifi-apis
SPEC_SHA=ea6a5bc3bb7a8744768fb64f5717b3694db104c7
SPEC_VERSION=10.4.57
SPEC_SHA256=ee1492cf23390482e4c1fd263dd199c5e0650959a1b60bb946a5e773da3d035b
